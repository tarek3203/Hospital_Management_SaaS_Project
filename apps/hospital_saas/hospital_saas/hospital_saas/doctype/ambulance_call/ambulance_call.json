{
 "doctype": "DocType",
 "name": "Ambulance Call",
 "module": "Hospital SaaS",
 "custom": 0,
 "istable": 0,
 "autoname": "format:AMB-{YYYY}-{#####}",
 "naming_rule": "Expression",
 "title_field": "patient_name",
 "track_changes": 1,
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "owner": "Administrator",
 "creation": "2026-10-10 07:00:00.000000",
 "modified": "2026-10-10 07:00:00.000000",
 "field_order": [
  "patient",
  "patient_name",
  "vehicle",
  "driver_name",
  "call_date",
  "call_time",
  "pickup",
  "destination",
  "distance_km",
  "charge",
  "status",
  "note"
 ],
 "fields": [
  {
   "fieldname": "patient",
   "fieldtype": "Link",
   "label": "Patient",
   "options": "Patient",
   "reqd": 1
  },
  {
   "fieldname": "patient_name",
   "fieldtype": "Data",
   "label": "Patient name",
   "fetch_from": "patient.patient_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Link",
   "label": "Vehicle",
   "options": "Ambulance Vehicle",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "driver_name",
   "fieldtype": "Data",
   "label": "Driver",
   "fetch_from": "vehicle.driver_name",
   "read_only": 1
  },
  {
   "fieldname": "call_date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "default": "Today"
  },
  {
   "fieldname": "call_time",
   "fieldtype": "Time",
   "label": "Time"
  },
  {
   "fieldname": "pickup",
   "fieldtype": "Data",
   "label": "Pickup from",
   "reqd": 1
  },
  {
   "fieldname": "destination",
   "fieldtype": "Data",
   "label": "Destination",
   "reqd": 1
  },
  {
   "fieldname": "distance_km",
   "fieldtype": "Float",
   "label": "Distance (km)"
  },
  {
   "fieldname": "charge",
   "fieldtype": "Currency",
   "label": "Charge",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Booked\nOn the way\nCompleted\nCancelled",
   "default": "Booked",
   "in_list_view": 1
  },
  {
   "fieldname": "note",
   "fieldtype": "Small Text",
   "label": "Note"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,

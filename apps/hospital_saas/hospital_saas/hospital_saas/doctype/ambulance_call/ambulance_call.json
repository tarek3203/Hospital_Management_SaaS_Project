   "create": 1,
   "delete": 1,
   "report": 1,
   "print": 1,
   "export": 1
  },
  {
   "role": "Healthcare Administrator",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "print": 1,
   "export": 1
  },
  {
   "role": "Receptionist",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "print": 1
  }
 ]
}